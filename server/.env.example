# Audelle backend environment (copy to .env / host environment variables)

# Persistent volume paths. On a host without a volume these fall back to /tmp,
# which is wiped on restart.
AUDIO_STORAGE_DIR=/data/storage
TORCH_HOME=/data/torch
HF_HOME=/data/huggingface
XDG_CACHE_HOME=/data/cache

# Comma-separated allowlist. Production must name the site origin.
# Leave unset only for local development.
AUDIDELLE_CORS_ORIGINS=https://audelle.vercel.app

# Optional S3 mirror. boto3 must be installed separately.
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Optional model/LLM settings used elsewhere in the server.
# HF_TOKEN=
# PROMPT_LLM_MODEL=
